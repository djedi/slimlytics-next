# Application
SLIMLYTICS_BASE_URL=http://localhost:8080
RUST_LOG=slimlytics=info,tower_http=info
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# For direct public TLS with compose.production.yaml, uncomment and set:
# SLIMLYTICS_DOMAIN=analytics.example.com
# ACME_EMAIL=admin@example.com

# Database
POSTGRES_DB=slimlytics
POSTGRES_USER=slimlytics
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Authentication and privacy
JWT_SECRET=replace-with-at-least-32-random-bytes
VISITOR_HASH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=3600
TRUST_PROXY=false
# Optional MaxMind GeoLite2/GeoIP2 City database used when trusted edge headers are unavailable.
# GEOIP_DATABASE_PATH=/data/GeoLite2-City.mmdb

# Optional Google Search Console OAuth integration. Configure all four together.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://analytics.example.com/api/integrations/search-console/callback
# Generate 32 random bytes and base64 encode them. Rotating this disconnects stored integrations.
# INTEGRATION_ENCRYPTION_KEY=

# Compose derives DATABASE_URL and the frontend ORIGIN from these values.
